VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PAYMENT_PROVIDER=fedapay

# Read by supabase/config.toml's env() substitution for [auth.email.smtp] —
# NOT read by Vite (no VITE_ prefix), so this never ships to the browser.
# For a hosted Supabase project this same SMTP config is set via
# `supabase secrets set` or the dashboard instead — config.toml's
# [auth.email.smtp] only governs the local CLI stack.
SUPABASE_AUTH_SMTP_USER=your-mailbox@your-domain.com
SUPABASE_AUTH_SMTP_PASS=your-mailbox-password
