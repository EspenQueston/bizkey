SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
ONEBOUND_KEY=your-onebound-key
ONEBOUND_SECRET=your-onebound-secret
FEDAPAY_API_KEY=your-fedapay-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
# Shared secret n8n's "WA - Receive Event" webhook checks against
# (x-bizkey-webhook-secret header) — used both for whatsapp-sync inbound
# calls and as the outbound auth whatsapp-agent-reply sends to n8n.
WHATSAPP_WEBHOOK_SECRET=your-shared-webhook-secret
# n8n Webhook Trigger URL that receives a dashboard agent's typed reply and
# forwards it to your existing "WA - Send Reply" / Evolution API step —
# without this, agent replies save in BizKey but never reach WhatsApp.
N8N_AGENT_REPLY_WEBHOOK_URL=https://your-n8n-instance/webhook/bizkey-agent-reply
# Outbound SMTP for transactional email (team-invite notifications, etc).
# Port 465 = implicit TLS (SMTP_SECURE=true). Ports 25/587 are unreliable on
# Supabase's hosted edge runtime — stick to 465 or a provider port like
# AWS SES's 2587 if you switch providers.
SMTP_HOSTNAME=mail.your-domain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your-mailbox@your-domain.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=BizKey <your-mailbox@your-domain.com>
